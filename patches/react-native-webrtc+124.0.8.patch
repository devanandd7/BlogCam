+package com.oney.WebRTCModule;
+
+import android.hardware.camera2.CameraCaptureSession;
+import android.hardware.camera2.CameraCharacteristics;
+import android.hardware.camera2.CameraDevice;
+import android.hardware.camera2.CaptureRequest;
+import android.os.Handler;
+import android.util.Range;
+import android.view.Surface;
+
+import androidx.core.util.Consumer;
+
+import org.webrtc.Camera2Capturer;
+import org.webrtc.VideoCapturer;
+
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.util.Arrays;
+
+final class Camera2TorchController {
+    private static final String CAMERA2_SESSION_CLASS = "org.webrtc.Camera2Session";
+
+    private Camera2TorchController() {}
+
+    static void setTorchEnabled(
+            VideoCapturer videoCapturer,
+            boolean enabled,
+            Consumer<Exception> onFinishedCallback) {
+        if (!(videoCapturer instanceof Camera2Capturer)) {
+            onFinishedCallback.accept(new IllegalStateException(
+                    "Torch control requires the active WebRTC Camera2 capture session."));
+            return;
+        }
+
+        try {
+            Object session = readField(videoCapturer, "currentSession");
+            if (session == null || !CAMERA2_SESSION_CLASS.equals(session.getClass().getName())) {
+                onFinishedCallback.accept(new IllegalStateException(
+                        "The active WebRTC Camera2 session is not ready."));
+                return;
+            }
+
+            Handler cameraHandler = (Handler) readField(session, "cameraThreadHandler");
+            if (!cameraHandler.post(() -> applyTorch(session, enabled, cameraHandler, onFinishedCallback))) {
+                onFinishedCallback.accept(new IllegalStateException(
+                        "The WebRTC camera thread is no longer available."));
+            }
+        } catch (ReflectiveOperationException | ClassCastException error) {
+            onFinishedCallback.accept(new IllegalStateException(
+                    "Could not access the active WebRTC Camera2 session.", error));
+        }
+    }
+
+    private static void applyTorch(
+            Object session,
+            boolean enabled,
+            Handler cameraHandler,
+            Consumer<Exception> onFinishedCallback) {
+        try {
+            CameraCharacteristics characteristics =
+                    (CameraCharacteristics) readField(session, "cameraCharacteristics");
+            Integer facing = characteristics.get(CameraCharacteristics.LENS_FACING);
+            Boolean flashAvailable = characteristics.get(CameraCharacteristics.FLASH_INFO_AVAILABLE);
+            if (facing != null && facing != CameraCharacteristics.LENS_FACING_BACK) {
+                if (enabled) {
+                    throw new IllegalStateException("Flash is only available on the rear camera.");
+                }
+                onFinishedCallback.accept(null);
+                return;
+            }
+            if (!Boolean.TRUE.equals(flashAvailable)) {
+                if (enabled) {
+                    throw new IllegalStateException("This rear camera does not have a flash.");
+                }
+                onFinishedCallback.accept(null);
+                return;
+            }
+
+            CameraDevice cameraDevice = (CameraDevice) readField(session, "cameraDevice");
+            CameraCaptureSession captureSession =
+                    (CameraCaptureSession) readField(session, "captureSession");
+            Surface surface = (Surface) readField(session, "surface");
+            if (cameraDevice == null || captureSession == null || surface == null) {
+                throw new IllegalStateException("The active WebRTC camera capture is not ready.");
+            }
+
+            CaptureRequest.Builder request = cameraDevice.createCaptureRequest(CameraDevice.TEMPLATE_RECORD);
+            Object captureFormat = readField(session, "captureFormat");
+            Object frameRateRange = readField(captureFormat, "framerate");
+            int fpsUnitFactor = (Integer) readField(session, "fpsUnitFactor");
+            int minFrameRate = (Integer) readField(frameRateRange, "min") / fpsUnitFactor;
+            int maxFrameRate = (Integer) readField(frameRateRange, "max") / fpsUnitFactor;
+            request.set(
+                    CaptureRequest.CONTROL_AE_TARGET_FPS_RANGE,
+                    new Range<>(minFrameRate, maxFrameRate));
+            request.set(CaptureRequest.CONTROL_AE_MODE, CaptureRequest.CONTROL_AE_MODE_ON);
+            request.set(CaptureRequest.CONTROL_AE_LOCK, false);
+            setStabilizationMode(request, characteristics);
+            setFocusMode(request, characteristics);
+            request.set(
+                    CaptureRequest.FLASH_MODE,
+                    enabled ? CaptureRequest.FLASH_MODE_TORCH : CaptureRequest.FLASH_MODE_OFF);
+            request.addTarget(surface);
+            captureSession.setRepeatingRequest(
+                    request.build(),
+                    createCaptureCallback(session),
+                    cameraHandler);
+            onFinishedCallback.accept(null);
+        } catch (Exception error) {
+            onFinishedCallback.accept(error);
+        }
+    }
+
+    private static void setStabilizationMode(
+            CaptureRequest.Builder request,
+            CameraCharacteristics characteristics) {
+        int[] opticalModes =
+                characteristics.get(CameraCharacteristics.LENS_INFO_AVAILABLE_OPTICAL_STABILIZATION);
+        int[] videoModes =
+                characteristics.get(CameraCharacteristics.CONTROL_AVAILABLE_VIDEO_STABILIZATION_MODES);
+        if (contains(opticalModes, CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE_ON)) {
+            request.set(
+                    CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE,
+                    CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE_ON);
+            request.set(
+                    CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE,
+                    CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE_OFF);
+        } else if (contains(videoModes, CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE_ON)) {
+            request.set(
+                    CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE,
+                    CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE_ON);
+            request.set(
+                    CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE,
+                    CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE_OFF);
+        }
+    }
+
+    private static void setFocusMode(
+            CaptureRequest.Builder request,
+            CameraCharacteristics characteristics) {
+        int[] focusModes = characteristics.get(CameraCharacteristics.CONTROL_AF_AVAILABLE_MODES);
+        if (contains(focusModes, CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_VIDEO)) {
+            request.set(
+                    CaptureRequest.CONTROL_AF_MODE,
+                    CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_VIDEO);
+        }
+    }
+
+    private static boolean contains(int[] values, int value) {
+        return values != null && Arrays.stream(values).anyMatch(candidate -> candidate == value);
+    }
+
+    private static CameraCaptureSession.CaptureCallback createCaptureCallback(Object session)
+            throws ReflectiveOperationException {
+        Class<?> callbackClass = Class.forName(
+                CAMERA2_SESSION_CLASS + "$CameraCaptureCallback",
+                true,
+                session.getClass().getClassLoader());
+        Constructor<?> constructor = callbackClass.getDeclaredConstructor();
+        constructor.setAccessible(true);
+        return (CameraCaptureSession.CaptureCallback) constructor.newInstance();
+    }
+
+    private static Object readField(Object target, String name) throws ReflectiveOperationException {
+        Class<?> targetClass = target.getClass();
+        while (targetClass != null) {
+            try {
+                Field field = targetClass.getDeclaredField(name);
+                field.setAccessible(true);
+                return field.get(target);
+            } catch (NoSuchFieldException ignored) {
+                targetClass = targetClass.getSuperclass();
+            }
+        }
+        throw new NoSuchFieldException(name);
+    }
+}
