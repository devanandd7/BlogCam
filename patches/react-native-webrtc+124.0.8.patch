@@ -0,0 +1,73 @@
+package com.oney.WebRTCModule;
+
+import android.content.Context;
+
+import org.webrtc.CapturerObserver;
+import org.webrtc.SurfaceTextureHelper;
+import org.webrtc.VideoCapturer;
+import org.webrtc.VideoFrame;
+
+public final class ExternalVideoCapturer implements VideoCapturer {
+    private static ExternalVideoCapturer activeCapturer;
+    private static CapturerObserver activeObserver;
+    private CapturerObserver observer;
+    private boolean started;
+
+    @Override
+    public void initialize(
+            SurfaceTextureHelper surfaceTextureHelper,
+            Context applicationContext,
+            CapturerObserver capturerObserver) {
+        observer = capturerObserver;
+    }
+
+    @Override
+    public void startCapture(int width, int height, int framerate) {
+        started = true;
+        if (observer != null) {
+            observer.onCapturerStarted(true);
+        }
+        synchronized (ExternalVideoCapturer.class) {
+            activeCapturer = this;
+            activeObserver = observer;
+        }
+    }
+
+    @Override
+    public void stopCapture() {
+        started = false;
+        synchronized (ExternalVideoCapturer.class) {
+            if (activeCapturer == this) {
+                activeCapturer = null;
+                activeObserver = null;
+            }
+        }
+        if (observer != null) {
+            observer.onCapturerStopped();
+        }
+    }
+
+    @Override
+    public void changeCaptureFormat(int width, int height, int framerate) {}
+
+    @Override
+    public void dispose() {
+        stopCapture();
+        observer = null;
+    }
+
+    @Override
+    public boolean isScreencast() {
+        return false;
+    }
+
+    public static boolean isStreaming() {
+        synchronized (ExternalVideoCapturer.class) {
+            return activeObserver != null;
+        }
+    }
+
+    public static void publish(VideoFrame frame) {
+        CapturerObserver currentObserver;
+        synchronized (ExternalVideoCapturer.class) {
+            currentObserver = activeObserver;
+        }
+        if (currentObserver != null) {
+            currentObserver.onFrameCaptured(frame);
+        }
+    }
+}
